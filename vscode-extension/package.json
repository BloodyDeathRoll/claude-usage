{
  "name": "tracker-claude-usage",
  "displayName": "Tracker Claude Usage",
  "description": "Real-time Claude Code session and weekly token usage in the status bar, plus the floating overlay. Everything is bundled — nothing to install.",
  "version": "0.4.0",
  "publisher": "EinHanamer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BloodyDeathRoll/claude-usage.git"
  },
  "homepage": "https://github.com/BloodyDeathRoll/claude-usage#readme",
  "bugs": {
    "url": "https://github.com/BloodyDeathRoll/claude-usage/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "anthropic",
    "usage",
    "tokens",
    "ai"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeUsage.refresh",
        "title": "Claude Usage: Refresh Now"
      },
      {
        "command": "claudeUsage.openOverlay",
        "title": "Claude Usage: Open Detailed Overlay"
      }
    ],
    "configuration": {
      "title": "Claude Usage",
      "properties": {
        "claudeUsage.sessionLimitTokens": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "Session token limit for your plan (used for local fallback %). Pro=320000, Max5=1600000, Max20=6400000. Leave null to show raw counts."
        },
        "claudeUsage.weeklyLimitTokens": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "Weekly token limit for your plan (used for local fallback %)."
        },
        "claudeUsage.weeklyModelLimits": {
          "type": [
            "object",
            "null"
          ],
          "default": null,
          "description": "Per-model weekly limits, e.g. { \"sonnet\": 436000, \"haiku\": 25000 }. Used for local fallback only."
        },
        "claudeUsage.overlayPath": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Absolute path to a claude-usage overlay directory (where main.js lives). Leave null to use the copy bundled with the extension."
        }
      }
    }
  },
  "devDependencies": {
    "@electron/get": "^3.1.0",
    "@vscode/vsce": "^3.0.0",
    "extract-zip": "^2.0.1"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:all": "node scripts/build.js --all"
  }
}
